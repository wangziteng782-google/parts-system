# parts-system 生产环境配置模板
# 复制为项目根目录 .env 后填写真实密码和密钥；不要把填写后的 .env 打进部署包。

# parts_database
PARTS_DB_HOST=127.0.0.1
PARTS_DB_PORT=3306
PARTS_DB_NAME=parts_database
PARTS_DB_USER=parts_database
PARTS_DB_PASSWORD=
PARTS_DB_CHARSET=utf8mb4
PARTS_DB_CONNECT_TIMEOUT=10

# OA 询价数据库（生产环境建议使用仅有 SELECT 权限的账号）
OA_DB_HOST=120.46.152.222
OA_DB_PORT=3306
OA_DB_NAME=oa_yixiuti
OA_DB_USER=oa_yixiuti
OA_DB_PASSWORD=
OA_DB_CONNECT_TIMEOUT=5
OA_DB_READ_TIMEOUT=12

# 正式系统 JWT 与本系统会话
PARTS_AUTH_REQUIRED=true
JWT_TOKEN_NAME=Admin-Token
JWT_SECRET_KEY=
JWT_TOKEN_EXP_SECONDS=432000
PARTS_SESSION_SECRET_KEY=
PARTS_SESSION_COOKIE_NAME=parts_system_session
PARTS_SESSION_MAX_MINUTES=7200
PARTS_ADMIN_ROLE_IDS=1
PARTS_SALES_ROLE_IDS=3,31,32
PARTS_PURCHASE_ROLE_IDS=4,36,37

# 七牛云
QINIU_ACCESS_KEY=
QINIU_SECRET_KEY=
QINIU_BUCKET=yiti-soft
QINIU_DOMAIN=http://soft.yitikeji.cn
